<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591;EF1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MSTest" Version="4.5.1" />
      <!--
          The design-time services `dotnet ef migrations add` builds (MigrationScaffoldTests), at the
          EF Core version the provider resolves. Test-only: the shipping package never references it.
      -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.2.26504.105" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The process-wide zone switch the local-kind tests run under (#119); one copy, linked. -->
        <Compile Include="..\CodoMetis.ValueRanges.Tests\LocalTimeZone.cs" Link="LocalTimeZone.cs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL\CodoMetis.ValueRanges.EFCore.PostgreSQL.csproj" />
    </ItemGroup>

</Project>
