<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="4.5.1" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <!--
            Test-only, and only here: ComplexIndexesCrossTests proves that this package's columns work
            under EFCore.ComplexIndexes.PostgreSQL's temporal and exclusion constraints and GiST indexes.
            Neither shipping package references the other.

            Off on the 11 line until ComplexIndexes ships its own 11.0.0-preview.1
            (CaffeinatedCoder/EFCore.ComplexIndexes#38): 5.4.x pins Npgsql.EntityFrameworkCore.PostgreSQL
            to [10.0.0, 11.0.0), which a net11.0 restore cannot satisfy. The condition keeps the reference
            and the test file where they are, so CaffeinatedCoder/EFCore.ComplexIndexes#42 restores them
            by moving the version and dropping the condition (#103).
        -->
        <PackageReference Include="EFCore.ComplexIndexes.PostgreSQL" Version="5.4.0" Condition="'$(TargetFramework)' == 'net10.0'" />
        <!--
            The design-time services and C# compiled-model generator `dotnet ef dbcontext optimize` runs, at
            the EF Core version the provider resolves, and the Roslyn they bring, which compiles the generated
            model in-process (CompiledModelJsonTests). Test-only: the shipping package never references it.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.2.26504.105" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
        <!-- With the package reference above, and back with it (CaffeinatedCoder/EFCore.ComplexIndexes#42). -->
        <Compile Remove="ComplexIndexesCrossTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The representative wrapper element type per family, shared with the conventions suite
            rather than copied: the arities are only reachable once closed over something, and a
            third definition would let the live round trips drift from what the contract tests
            check. Linked instead of moved so the conventions project keeps no reference to this
            one, which needs Docker.
        -->
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\WrapperElements.cs"
                 Link="WrapperElements.cs" />
        <!-- The probe values per element type, shared for the same reason (CapturedCollectionProbeTests). -->
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\RangeProbes.cs" Link="RangeProbes.cs" />
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\RangeCensus.cs" Link="RangeCensus.cs" />
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\SetProbes.cs" Link="SetProbes.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL\CodoMetis.ValueRanges.EFCore.PostgreSQL.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The candidate registry of the oracle sweeps, shared by every project that holds one
            (see test/oracles/README.md). Linked, not referenced, so the projects stay independent.
        -->
        <Compile Include="..\oracles\Candidates.cs" Link="Candidates.cs" />
        <Compile Include="..\oracles\StringOverloads.cs" Link="StringOverloads.cs" />
    </ItemGroup>

    <!--
        The booking service docs/walkthrough.md walks through (samples/Bookings), hosted in-process by
        WalkthroughSampleTests against the shared server, so the page's claims have a holder this suite
        runs. Linked, not copied: the test exercises the sample's own endpoints, entities and migration.
        Program.cs stays out, because the test host composes the same three calls itself.
        test/consumer-smoke-test.sh runs the sample as a reader would, against the packed packages.
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0-rc.2.26504.105" />
        <Compile Include="..\..\samples\Bookings\**\*.cs" Exclude="..\..\samples\Bookings\Program.cs;..\..\samples\Bookings\obj\**;..\..\samples\Bookings\bin\**"
                 Link="Walkthrough\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
