<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MSTest" Version="4.5.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\CodoMetis.ValueRanges\CodoMetis.ValueRanges.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The candidate registry of the oracle sweeps, shared by every project that holds one
            (see test/oracles/README.md). Linked, not referenced, so the projects stay independent.
        -->
        <Compile Include="..\oracles\Candidates.cs" Link="Candidates.cs" />
    </ItemGroup>

</Project>
