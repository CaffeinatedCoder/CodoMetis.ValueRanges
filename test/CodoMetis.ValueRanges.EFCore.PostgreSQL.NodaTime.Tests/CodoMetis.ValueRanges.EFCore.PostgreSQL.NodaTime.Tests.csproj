<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591;EF1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MSTest" Version="4.5.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The post-interception query tree reader (#288), shared with the base package's translation tests; one copy, linked. -->
        <Compile Include="..\CodoMetis.ValueRanges.EFCore.PostgreSQL.Tests\InterceptedQuery.cs" Link="InterceptedQuery.cs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime.csproj" />
    </ItemGroup>

</Project>
