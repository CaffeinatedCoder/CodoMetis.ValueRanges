<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
        <PackageReference Include="MSTest" Version="4.5.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges\CodoMetis.ValueRanges.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.NodaTime\CodoMetis.ValueRanges.NodaTime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            HostCultureProbeTests sweeps every discovered type through a host, so it takes the type
            discovery and probe values from the conventions project, linked rather than copied (a
            second probe table would drift), and the candidate registry every oracle shares.
        -->
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\RangeProbes.cs" Link="Probes\RangeProbes.cs" />
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\SetProbes.cs" Link="Probes\SetProbes.cs" />
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\WrapperElements.cs" Link="Probes\WrapperElements.cs" />
        <Compile Include="..\CodoMetis.ValueRanges.Conventions.Tests\Reflect.cs" Link="Probes\Reflect.cs" />
        <Compile Include="..\oracles\Candidates.cs" Link="Candidates.cs" />
    </ItemGroup>

</Project>
