<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MSTest" Version="4.5.1" />
      <PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.NodaTime\CodoMetis.ValueRanges.NodaTime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- One reflection sweep for both packages' per-type aggregate overloads (#361). -->
        <Compile Include="..\CodoMetis.ValueRanges.Tests\AggregateNullInputs.cs" Link="AggregateNullInputs.cs" />
    </ItemGroup>

</Project>
