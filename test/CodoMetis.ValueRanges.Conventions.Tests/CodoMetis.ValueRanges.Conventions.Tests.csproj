<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591;EF1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <!-- Configuration binding is an entry point with no host: CultureEntryPointProbeTests binds every type. -->
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="MSTest" Version="4.5.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <!-- References every shipping project: these tests discover types and projects by
         reflection and by walking the repository, never from a hard-coded list. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges\CodoMetis.ValueRanges.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.NodaTime\CodoMetis.ValueRanges.NodaTime.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL\CodoMetis.ValueRanges.EFCore.PostgreSQL.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            The candidate registry of the oracle sweeps, shared by every project that holds one
            (see test/oracles/README.md). Linked, not referenced, so the projects stay independent.
        -->
        <Compile Include="..\oracles\Candidates.cs" Link="Candidates.cs" />
        <Compile Include="..\oracles\TranslationSupport.cs" Link="TranslationSupport.cs" />
        <!--
            The clone-divergence sweep's engine (docs/oracles.md#the-clone-divergence-sweep). Linked here
            and compiled into tools/oracles.cs through tools/Directory.Build.props, so the test and the
            tool run the same code.
        -->
        <Compile Include="..\oracles\CloneSweep.cs" Link="CloneSweep.cs" />
        <!-- The rule `tools/oracles.cs seeds` judges a failed test by, compiled into it the same way (#55). -->
        <Compile Include="..\oracles\SeedVerdict.cs" Link="SeedVerdict.cs" />
        <Compile Include="..\oracles\StringOverloads.cs" Link="StringOverloads.cs" />
    </ItemGroup>

</Project>
