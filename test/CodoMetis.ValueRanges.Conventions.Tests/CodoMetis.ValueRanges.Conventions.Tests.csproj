<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);1591;EF1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
        <PackageReference Include="MSTest" Version="4.3.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <!-- References every shipping project: these tests discover types and projects by
         reflection and by walking the repository, never from a hard-coded list. -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges\CodoMetis.ValueRanges.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.NodaTime\CodoMetis.ValueRanges.NodaTime.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL\CodoMetis.ValueRanges.EFCore.PostgreSQL.csproj" />
        <ProjectReference Include="..\..\src\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime\CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime.csproj" />
    </ItemGroup>

</Project>
