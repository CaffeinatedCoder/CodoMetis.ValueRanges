{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "obj/pub",
          "files": [
            "CodoMetis.ValueRanges.dll",
            "CodoMetis.ValueRanges.NodaTime.dll",
            "CodoMetis.ValueRanges.EFCore.PostgreSQL.dll",
            "CodoMetis.ValueRanges.EFCore.PostgreSQL.NodaTime.dll"
          ]
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml" ] },
      { "src": "obj/api", "dest": "api", "files": [ "**.yml" ] },
      {
        "src": "..",
        "files": [
          "README.md",
          "CHANGELOG.md",
          "CONTRIBUTING.md",
          "SECURITY.md",
          "AGENTS.md",
          "docs/*.md",
          "src/*/README.md"
        ]
      }
    ],
    "resource": [
      { "src": "..", "files": [ "LICENSE", ".claude/skills/*/SKILL.md" ] }
    ],
    "output": "obj/_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appTitle": "CodoMetis.ValueRanges",
      "_appName": "CodoMetis.ValueRanges",
      "_appFooter": "MIT licensed · <a href=\"https://github.com/CaffeinatedCoder/CodoMetis.ValueRanges\">GitHub</a>",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
